# Copy to /etc/miimo/relay.env on the VPS (loaded by deploy/miimo.service)

# Public dashboard listener (anyone can connect; send-only websocket)
PUBLIC_HOST=0.0.0.0
PUBLIC_PORT=80

# Remote-control listener. Keep on loopback; `tailscale serve` exposes it to the tailnet.
REMOTE_HOST=127.0.0.1
REMOTE_PORT=8787

# Require the Tailscale-User-Login header that `tailscale serve` adds.
# Set to 0 ONLY for local development.
REQUIRE_TAILSCALE_HEADER=1

# Where the static pages live
WEB_DIR=/opt/miimo/webapp/web

# How many past detections a newly connected dashboard receives
HISTORY_LIMIT=50

# Hardware bridge (bridge.py) connects to ws://<host>:<PUBLIC_PORT>/device with
# `Authorization: Bearer <DEVICE_TOKEN>`. Leave empty to disable /device entirely.
DEVICE_TOKEN=

# Which motor sits at each neckband position, in this order:
# left tip, rear left, rear centre, rear right, right tip
POS_MAP=M1,M2,M3,M4,M5

# Vibration strength at startup, 0..1. The dashboard's Device page can change it while
# the server runs; a restart returns to this value.
STRENGTH=0.25

# Local development: `npm run dev` reads webapp/server/.env (not committed). Put there:
#   PUBLIC_PORT=8080
#   REQUIRE_TAILSCALE_HEADER=0
#   DEVICE_TOKEN=dev
#   WEB_DIR=../web
